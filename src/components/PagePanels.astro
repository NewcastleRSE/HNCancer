---

<!-- right side, stretches full height -->
<div id="right-panel" class="grid-panel">
  <!-- Output container for messages -->
  <div id="search-message"></div>

  <!-- Output target container for chart -->
  <div id="csv-chart"></div>

  <!-- Output target containers for tables -->
  <div id="csv-table"></div>
  <div id="search-results" style="width: 100%;"></div>
  <div id="download-link"></div>
</div>

<style>
  /* individual grid panels */
  .grid-panel {
    background-color: var(--bulma-background-color);
    border: 1px solid var(--color-border-div);
    box-sizing: border-box;
    overflow: auto;
    padding: 20px;
  }

  /* right side goes from top to bottom, place for data? */
  #right-panel {
    grid-column: 2;
    grid-row: 1;
    border-left: 2px solid var(--color-border-div);
  }

  /* responsiveness... */
  @media (max-width: 768px) {
    .dashboard-container {
      display: flex;
      flex-direction: column;
      height: auto;
      overflow-y: auto;
    }
    html,
    body {
      overflow: auto;
      height: auto;
    }
    #map {
      height: 400px;
    }
    #bottom-panel,
    #right-panel {
      height: auto;
      width: 100%;
      border-left: none;
      border-top: 1px solid var(--color-border-div);
    }
  }

  #container {
    height: 100%;
  }

  /* Chart/table styling - needs global selector so not locally scoped so eCharts can access */
  :global(#csv-chart) {
    width: max(100%, 600px);
    height: 450px;
    min-width: 400px;
  }

  :global(#csv-table) {
    width: 1000px;
    height: 10px;
  }

  /* Message styling */
  .search-message {
    width: 100%;
    min-height: 1.5em;
  }

  .search-message.is-hidden {
    min-height: 0;
    height: 0;
  }
</style>
