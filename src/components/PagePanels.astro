<script>
  const tabLinks = document.querySelectorAll<HTMLAnchorElement>("[data-tab]");

  const chartTab = document.getElementById("chart-tab");
  const tableTab = document.getElementById("table-tab");

  // Update tabs when clicked
  tabLinks.forEach((tabLink) => {
    tabLink.addEventListener("click", () => {
      const tab = tabLink.dataset.tab;

      if (tab !== "chart" && tab !== "table") {
        return;
      }

      tabLinks.forEach((link) => {
        link.parentElement?.classList.toggle("is-active", link === tabLink);
      });

      chartTab?.classList.toggle("is-active", tab === "chart");

      tableTab?.classList.toggle("is-active", tab === "table");
    });
  });
</script>

<!-- right side, stretches full height -->
<div id="right-panel" class="grid-panel">
  <!-- Div for any messages for user after attempted search -->
  <div id="search-message"></div>

  <!-- Tabbed results -->
  <div id="output-tabs">
    <div id="tab-buttons" class="tabs is-boxed is-hidden">
      <ul>
        <!-- Chart tab -->
        <li class="is-active">
          <a data-tab="chart">
            <span class="material-symbols-outlined tab-icon">bid_landscape</span
            >
            <span>Chart</span>
          </a>
        </li>

        <!-- Table tab -->
        <li>
          <a data-tab="table">
            <span class="material-symbols-outlined tab-icon">table</span>
            <span>Table</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Tab contents -->
    <div id="tab-contents">
      <!-- Chart tab content -->
      <div id="chart-tab" class="tab-content is-active">
        <div id="chart-toolbar" class="chart-toolbar"></div>
        <div id="csv-chart"></div>
      </div>

      <!-- Table tab content -->
      <div id="table-tab" class="tab-content">
        <div id="table-toolbar" class="chart-toolbar"></div>
        <div id="csv-table"></div>
      </div>
    </div>
  </div>
</div>

<style>
  /* individual grid panels */
  .grid-panel {
    background-color: var(--bulma-background-color);
    border: 1px solid var(--color-border-div);
    box-sizing: border-box;
    overflow: auto;
    padding: 20px;
  }

  /* right side goes from top to bottom, place for data? */
  #right-panel {
    grid-column: 2;
    grid-row: 1;
    border-left: 2px solid var(--color-border-div);
  }

  #tab-contents {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  /* Hide tab content when not active - use this approach so can still initialise charts
  before search results returned */
  .tab-content {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }

  .tab-content.is-active {
    visibility: visible;
  }

  /* responsiveness... */
  @media (max-width: 768px) {
    .dashboard-container {
      display: flex;
      flex-direction: column;
      height: auto;
      overflow-y: auto;
    }

    html,
    body {
      overflow: auto;
      height: auto;
    }

    #map {
      height: 400px;
    }

    #bottom-panel,
    #right-panel {
      height: auto;
      width: 100%;
      border-left: none;
      border-top: 1px solid var(--color-border-div);
    }
  }

  #container {
    height: 100%;
  }

  /* Chart/table styling - needs global selector so not locally scoped so eCharts can access */
  :global(#csv-chart) {
    width: max(100%, 600px);
    height: 550px;
    min-width: 812px;
  }

  :global(#csv-table) {
    width: 1000px;
    height: 10px;
  }

  /* Message styling */
  .search-message {
    width: 100%;
    min-height: 1.5em;
  }

  .search-message.is-hidden {
    min-height: 0;
    height: 0;
  }

  /* Icons */

  .tab-icon {
    font-family: "Material Symbols Outlined";
    font-size: 1.15rem;
    font-variation-settings:
      "FILL" 0,
      "wght" 400,
      "GRAD" 0;
  }

  /* Tabs spacing */
  .tabs li a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
</style>
