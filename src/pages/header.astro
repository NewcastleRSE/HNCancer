---
const currentPath = Astro.url.pathname;

// Paths to each page
// IMPORTANT - include trailing slash to ensure, active link styling works when deployed
const navItems = [
  { label: "Explore", href: "/HNCancer/explore/" },
  { label: "Methods", href: "/HNCancer/methods/" },
  { label: "About", href: "/HNCancer/about/" },
];
---

<div class="header-container">
  <a class="header-title" href="/HNCancer">
    <header id="page-header">
      <img
        class="header-logo"
        src="/public/images/UNEQUAL-HNC_logo_small.svg"
        alt="Small logo for Unequal-HNC: Unravelling Inequalities in Head and Neck Cancer that is a red magnifying containing the silhouette of a head."
        width="70rem"
      />
      <div>
        <p class="header-text-small">UNEQUAL-HNC</p>
        <p class="header-text-large">
          Head&nbspand&nbspNeck&nbspCancer <span class="header-text-emphasis"
            >Data&nbspHub</span
          >
        </p>
      </div>
    </header>
  </a>

  <nav class="navbar" role="navigation" aria-label="main navigation">
    <a
      role="button"
      id="nav-burger"
      class="navbar-burger"
      aria-label="menu"
      aria-expanded="false"
      data-target="nav-links"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </a>
    <div id="nav-links" class="navbar-start">
      {
        navItems.map(({ label, href }) => (
          <a
            class="navbar-item is-size-5"
            href={href}
            aria-current={currentPath === href ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</div>
<script>
  document.addEventListener("DOMContentLoaded", (): void => {
    // Get the burger element and the target menu

    const burger = document.getElementById("nav-burger") as HTMLFormElement;
    const menu = document.getElementById("nav-links") as HTMLFormElement;

    if (burger && menu) {
      burger.addEventListener("click", (): void => {
        // Toggle the "is-active" class on both elements
        burger.classList.toggle("is-active");
        menu.classList.toggle("is-active");

        // Check state and convert the boolean to a string
        const isExpanded: boolean = menu.classList.contains("is-active");
        menu.setAttribute("aria-expanded", String(isExpanded));
      });
    }
  });

  // Add event listener to collapse expanded burger menu if window becomes larger
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 800) {
      const burger = document.getElementById("nav-burger") as HTMLFormElement;
      const menu = document.getElementById("nav-links") as HTMLFormElement;

      burger.classList.remove("is-active");
      menu.classList.remove("is-active");
      burger.setAttribute("aria-expanded", "false");
    }
  });
</script>

<style>
  .header-container {
    display: flex;
    background-color: var(--color-header);
    justify-content: space-between;
    align-items: center;
    color: var(--color-slate);
    padding: 1rem 1.5rem !important;
    flex-wrap: nowrap;
  }

  #page-header {
    display: flex;
    gap: 0rem;
    align-items: flex-start;
  }

  /* Change flex alignemnt when burger menu is open */
  .header-container:has(.navbar-burger.is-active) {
    align-items: flex-start;
  }

  /* Navbar */

  nav {
    background-color: var(--color-header);
  }

  .navbar {
    flex-shrink: 0;
    min-height: 0;
  }

  .navbar-start {
    flex: 0 0 auto;
  }

  .navbar-item {
    color: var(--color-slate);
    border-radius: 0.35rem;
    font-weight: 600;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  /* Navbar hover */
  .navbar-item:hover {
    color: var(--bulma-primary-35);
    background-color: var(--bulma-primary-95);
  }

  /* Navbar styling for current page */
  .navbar-item[aria-current="page"] {
    color: var(--bulma-primary);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }

  /* Navbar - Keyboard focus */
  .navbar-item:focus-visible,
  .navbar-burger:focus-visible {
    outline: 2px solid var(--bulma-primary-25);
    outline-offset: 2px;
  }

  /* Burger */
  .navbar-burger {
    color: var(--bulma-primary);
    border-radius: 0.35rem;
  }

  .navbar-burger:hover {
    color: var(--bulma-primary-35);
    background-color: var(--bulma-primary-95);
  }

  .navbar-start.is-active {
    display: block;
  }

  /* Overwrite Bulma breakpoints behaviour */
  @media (min-width: 850px) {
    .navbar-menu,
    .navbar-start,
    .navbar-end {
      display: flex;
      align-items: stretch;
    }

    .navbar-burger {
      display: none;
    }
  }

  @media (width <= 850px) {
    .navbar-burger {
      display: block;
    }

    .navbar-menu,
    .navbar-start,
    .navbar-end {
      display: none;
    }

    .navbar-start.is-active {
      display: block;
    }

    .navbar-start {
      background-color: var(--color-header);
      color: var(--bulma-primary-30);
      display: none;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition:
        max-height 0.25s ease,
        opacity 0.15s ease;
    }

    .navbar-start.is-active {
      max-height: 20rem;
      opacity: 1;
    }
  }

  /* When narrow window, force burger to beneath header text */
  @media (max-width: 675px) {
    .header-container {
      flex-wrap: wrap;
    }

    .header-container > div:first-child {
      flex: 1 1 auto;
      min-width: 0;
    }

    .navbar {
      flex-basis: 100%;
    }
  }

  /* Header text */

  .header-title {
    color: var(--color-slate);
    font-weight: 400;
  }

  .header-title:hover {
    color: var(--bulma-primary);
  }

  .header-text-small {
    font-size: 1rem;
  }

  .header-text-large {
    font-size: 1.75rem;
    font-weight: 400;
  }

  .header-text-emphasis {
    color: var(--bulma-primary);
    font-weight: 800;
  }
</style>
