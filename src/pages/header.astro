---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Search", href: "/HNCancer/dev" },
  { label: "Inequalities", href: "/HNCancer/inequalities" },
  { label: "About", href: "/HNCancer/" },
];
---

<div class="header-container">
  <div>
    <header>
      <p class="header-text-small">Atlas of Health Variation</p>
      <p class="header-text-large">Head and Neck Cancer in England</p>
    </header>
  </div>

  <nav class="navbar" role="navigation" aria-label="main navigation">
    <a
      role="button"
      id="nav-burger"
      class="navbar-burger"
      aria-label="menu"
      aria-expanded="false"
      data-target="nav-links"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </a>
    <div id="nav-links" class="navbar-start">
      {
        navItems.map(({ label, href }) => (
          <a
            class="navbar-item is-size-5"
            href={href}
            aria-current={currentPath === href ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</div>
<script>
  document.addEventListener("DOMContentLoaded", (): void => {
    // Get the burger element and the target menu

    const burger = document.getElementById("nav-burger") as HTMLFormElement;
    const menu = document.getElementById("nav-links") as HTMLFormElement;

    if (burger && menu) {
      burger.addEventListener("click", (): void => {
        // Toggle the "is-active" class on both elements
        burger.classList.toggle("is-active");
        menu.classList.toggle("is-active");

        // Check state and convert the boolean to a string
        const isExpanded: boolean = menu.classList.contains("is-active");
        menu.setAttribute("aria-expanded", String(isExpanded));
      });
    }
  });

  // Add event listener to collapse expanded burger menu if window becomes larger
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 800) {
      const burger = document.getElementById("nav-burger") as HTMLFormElement;
      const menu = document.getElementById("nav-links") as HTMLFormElement;

      burger.classList.remove("is-active");
      menu.classList.remove("is-active");
      burger.setAttribute("aria-expanded", "false");
    }
  });
</script>

<style>
  .header-container {
    display: flex;
    background-color: var(--color-header);
    justify-content: space-between;
    align-items: flex-end;
    color: var(--color-text-light);
    padding: 1rem 1.5rem;
    flex-wrap: nowrap;
  }

  /* Change flex alignemnt when burger menu is open */
  .header-container:has(.navbar-burger.is-active) {
    align-items: flex-start;
  }

  /* Navbar */

  nav {
    background-color: var(--color-header);
  }

  .navbar {
    flex-shrink: 0;
    min-height: 0;
  }

  .navbar-start {
    flex: 0 0 auto;
  }

  .navbar-item {
    color: color-mix(in srgb, var(--color-text-light) 80%, transparent);
    border-radius: 0.35rem;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  /* Navbar hover */
  .navbar-item:hover {
    color: var(--color-text-light);
    background-color: color-mix(
      in srgb,
      var(--color-text-light) 15%,
      transparent
    );
  }

  /* Navbar styling for current page */
  .navbar-item[aria-current="page"] {
    color: var(--color-text-light);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.5em;
  }

  /* Navbar - Keyboard focus */
  .navbar-item:focus-visible,
  .navbar-burger:focus-visible {
    outline: 2px solid var(--color-text-light);
    outline-offset: 2px;
  }

  /* Burger */
  .navbar-burger {
    color: var(--color-text-light);
    border-radius: 0.35rem;
  }

  .navbar-burger:hover {
    color: var(--color-text-light);
    background-color: color-mix(
      in srgb,
      var(--color-text-light) 15%,
      transparent
    );
  }

  .navbar-start.is-active {
    display: block;
  }

  /* Overwrite Bulma breakpoints behaviour */
  @media (min-width: 850px) {
    .navbar-menu,
    .navbar-start,
    .navbar-end {
      display: flex;
      align-items: stretch;
    }

    .navbar-burger {
      display: none;
    }
  }

  @media (width <= 850px) {
    .navbar-burger {
      display: block;
    }

    .navbar-menu,
    .navbar-start,
    .navbar-end {
      display: none;
    }

    .navbar-start.is-active {
      display: block;
    }

    .navbar-start {
      background-color: var(--color-header);
      color: var(--color-text-light);
      display: none;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition:
        max-height 0.25s ease,
        opacity 0.15s ease;
    }

    .navbar-start.is-active {
      max-height: 20rem;
      opacity: 1;
    }
  }

  /* When narrow window, force burger to beneath header text */
  @media (max-width: 768px) {
    .header-container {
      flex-wrap: wrap;
    }

    .header-container > div:first-child {
      flex: 1 1 auto;
      min-width: 0;
    }

    .navbar {
      flex-basis: 100%;
    }
  }

  /* Header text */

  .header-text-small {
    font-size: 1.25rem;
    text-transform: uppercase;
    font-weight: var(--bulma-weight-light);
  }

  .header-text-large {
    font-size: 2rem;
    font-weight: var(--bulma-weight-medium);
  }
</style>
