---
import Layout from "../layouts/Layout.astro";
import Header from "./header.astro";
import PagePanels from "../components/PagePanels.astro";
import Sidebar from "../components/Sidebar.svelte";
---

<Layout>
  <Header />
  <div class="dashboard-container">
    <Sidebar client:load />
    <PagePanels />
  </div>
</Layout>

<script>
  // Import PapaParse directly into your client bundle
  import Papa from "papaparse";
  import {
    getCancerCSVFilename,
    createTidyDownloadFile,
    createDownloadFilename,
    getChartDataUrl,
  } from "../utils/files";
  import { setMessageText, clearMessageText } from "../utils/messages";
  import {
    downloadDataElement,
    downloadChartSvg,
    downloadTableSvg,
  } from "../types";
  import {
    returnAllIncidenceChartSeries,
    returnAllIncidenceTableSeries,
    returnAllSurvivalSeries,
    renderLineChart,
    renderTableChart,
    renderBlankChart,
    initChart,
  } from "../utils/charts";
  import { queryFilter } from "../utils/query";
  import type {
    IncidenceCSVRow,
    SurvivalCSVRow,
    SearchQuery,
    IncidenceProcessedRow,
    SurvivalProcessedRow,
  } from "../types";

  // Tabs and download menu - will need to remove hidden attribute when search results are shown
  const tabButtons = document.getElementById("tab-buttons");
  const downloadDropdown = document.getElementById("download-dropdown");

  // Reset results helper
  function resetResults(messageText: string, messageType: "normal" | "danger") {
    renderBlankChart(myChart);
    renderBlankChart(myTable);
    setMessageText(messageText, messageType);
    tabButtons?.classList.add("is-hidden"); // rehide tab buttons
    downloadDropdown?.classList.add("is-hidden"); // rehide download button

    // Chart tab will be active on next successful search
    document.querySelector<HTMLAnchorElement>('[data-tab="chart"]')?.click();
  }

  // Initialise chart
  const myChart = initChart("csv-chart");

  // Initialise table
  const myTable = initChart("csv-table", false);

  document.addEventListener("cancer-query", async (event) => {
    // Casting as searchQuery - we know that the relationship between types was maintained
    // in the search component
    const searchQuery = (event as CustomEvent<SearchQuery>).detail;
    const { statistic, filter, cancer } = searchQuery; // unpack

    // Messages for if inputs are not provided; otherwise, run search
    if (!cancer) {
      resetResults("Please choose a HNC subsite.", "danger");
    } else if (!statistic) {
      resetResults("Please choose a statistic.", "danger");
    } else {
      console.log("Search filter:", filter);
      const CSV_file = getCancerCSVFilename(cancer, statistic);

      try {
        const response = await fetch(CSV_file);

        if (!response.ok) {
          throw new Error("Failed to retrieve data file.");
        }

        const csvText = await response.text();

        Papa.parse<IncidenceCSVRow | SurvivalCSVRow>(csvText, {
          header: true,
          skipEmptyLines: true,

          complete: (results) => {
            if (CSV_file === "") {
              resetResults(
                "Please choose a HNC subsite and statistic.",
                "danger",
              );

              return;
            }

            try {
              const rows = results.data;

              // ---------------------------------------------
              // Query
              // ---------------------------------------------

              let groupedResults;

              // Branch to handle types
              if (statistic === "incidence") {
                groupedResults = queryFilter({
                  statistic,
                  rows: rows as IncidenceCSVRow[],
                  filter,
                });
              } else if (statistic === "survival") {
                groupedResults = queryFilter({
                  statistic,
                  rows: rows as SurvivalCSVRow[],
                  filter,
                });
              } else {
                throw new Error(`Unsupported statistic: ${statistic}`);
              }

              console.log("filter:", filter);
              console.log("groupedResults:", groupedResults);

              if (groupedResults.length < 1) {
                resetResults(
                  "No data is available for these search filters.",
                  "danger",
                );
              } else {
                // ---------------------------------------------------------
                // Update chart and eCharts table
                // ---------------------------------------------------------

                clearMessageText(); // Remove search message text
                tabButtons?.classList.remove("is-hidden"); // Show output tabs
                downloadDropdown?.classList.remove("is-hidden"); // Show download menu

                // Branch to handle types - asserting types since know each statistic
                // will return processed rows with a matching type
                if (statistic === "incidence") {
                  // Data for charts
                  const allChartSeries = returnAllIncidenceChartSeries(
                    groupedResults as IncidenceProcessedRow[][],
                  );

                  // Data for tables (includes "all years")
                  const allTableSeries = returnAllIncidenceTableSeries(
                    groupedResults as IncidenceProcessedRow[][],
                  );

                  const chartArgs = {
                    statistic: statistic,
                    allSeries: allChartSeries,
                    cancer: cancer,
                    filter: filter,
                  };

                  const tableArgs = {
                    statistic: statistic,
                    allSeries: allTableSeries,
                    cancer: cancer,
                    filter: filter,
                  };

                  renderLineChart(myChart, chartArgs);
                  renderTableChart(myTable, tableArgs);
                } else if (statistic === "survival") {
                  // Data for charts and tables
                  const allSeries = returnAllSurvivalSeries(
                    groupedResults as SurvivalProcessedRow[][],
                  );

                  const chartArgs = {
                    statistic: statistic,
                    allSeries: allSeries,
                    cancer: cancer,
                    filter: filter,
                  };
                  renderLineChart(myChart, chartArgs);
                  renderTableChart(myTable, chartArgs); // can use same args for table for survival
                }

                // ---------------------------------------------
                // Download
                // ---------------------------------------------

                const encodedUri = createTidyDownloadFile(groupedResults);
                const filename = createDownloadFilename(
                  cancer + "_" + statistic,
                );

                // Data
                downloadDataElement.href = encodedUri;
                downloadDataElement.download = `${filename}_data.csv`;

                // Charts/tables - get image when clicked so updates depending on user's current view
                const downloads = [
                  {
                    element: downloadChartSvg,
                    chart: myChart,
                    suffix: "chart",
                  },
                  {
                    element: downloadTableSvg,
                    chart: myTable,
                    suffix: "table",
                  },
                ];

                for (const { element, chart, suffix } of downloads) {
                  element.addEventListener("click", () => {
                    element.href = getChartDataUrl(chart);
                    element.download = `${filename}_${suffix}.svg`;
                  });
                }
              }
            } catch (error) {
              console.error(error);
              const msg =
                error instanceof Error
                  ? error.message
                  : "Unable to process query.";
              resetResults(msg, "danger");
            }
          },

          error: (error: Error) => {
            resetResults(`Parsing error: ${error.message}`, "danger");
          },
        });
      } catch (err) {
        resetResults("Could not fetch CSV file with cancer data.", "danger");

        console.error(err);
      }
    }
  });
</script>

<style>
  #csv-search-form {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .dashboard-container {
    display: flex;
    flex: 1;
    min-height: 0;
    width: 100vw;
    gap: 0rem;
  }

  /* responsiveness */
  @media (max-width: 768px) {
    .dashboard-container {
      flex-direction: column;
      overflow-y: auto;
    }

    #right-panel {
      min-height: 800px;
      height: auto;
    }

    html,
    body {
      height: auto;
      overflow: auto;
    }
  }
</style>
