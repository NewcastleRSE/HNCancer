---
import Layout from "../layouts/Layout.astro";
import Header from "./header.astro";
import CancerTypeSelect from "../components/CancerTypeSelect.astro";
import PagePanels from "../components/PagePanels.astro";
import IncidenceQuerySelectionsDynamic from "../components/IncidenceQuerySelectionsDynamic.svelte";
// import IncidenceQuerySelections from "../components/IncidenceQuerySelections.svelte";
---

<Layout>
  <Header />

  <div class="dashboard-container">
    <!--- top left: panel area ---->
    <div id="search-panel">
      <h1 class="h1-search"><em>Search cancer data:</em></h1>
      <div class="search-section">
        <h2 class="query-section">Cancer</h2>
        <div><CancerTypeSelect /></div>
      </div>
      <div class="search-section">
        <h2 class="query-section">Statistic</h2>
        <p>TBA</p>
      </div>
      <hr />
      <!-- <IncidenceQuerySelections client:load /> -->
      <IncidenceQuerySelectionsDynamic client:load />
    </div>
    <PagePanels />
  </div>
</Layout>

<script>
  // Import PapaParse directly into your client bundle
  import Papa from "papaparse";
  import {
    cancerType,
    createTidyDownloadFile,
    createDownloadFilename,
  } from "../utils/filter";
  // import {
  //   generateSingleRowTable,
  //   generateMultiRowTable,
  //   generateDichotomyMultiRowTable,
  // } from "../utils/filter-new";
  import { setMessageText, clearMessageText } from "../utils/filter-new";
  import { cancer_type, downloadLinkBtn } from "../types";
  import {
    returnAllChartSeries,
    returnAllTableSeries,
    renderLineChart,
    renderTableChart,
    renderBlankChart,
    initChart,
  } from "../utils/charts";
  import { queryIncidenceFilter } from "../utils/query";
  import type { CSVRow, ProcessedRow, IncidenceFilter } from "../types";

  // Initialise chart
  const myChart = initChart("csv-chart");

  // Initialise table
  const myTable = initChart("csv-table", false);

  document.addEventListener("incidence-query", async (event) => {
    const filter = (event as CustomEvent<IncidenceFilter>).detail;

    console.log("Incidence filter:", filter);

    const CSV_file = cancerType(cancer_type.value);
    const cancerTypeToShow: string = cancer_type.value;

    try {
      const response = await fetch(CSV_file);

      if (!response.ok) {
        throw new Error("Failed to retrieve data file.");
      }

      const csvText = await response.text();

      Papa.parse<CSVRow>(csvText, {
        header: true,
        skipEmptyLines: true,

        complete: (results) => {
          if (CSV_file === "") {
            renderBlankChart(cancerTypeToShow, myChart);
            setMessageText("Please choose a cancer type.", "danger");

            downloadLinkBtn.innerHTML = "<p></p>";

            return;
          }

          try {
            const rows = results.data as ProcessedRow[];

            // ---------------------------------------------
            // Query
            // ---------------------------------------------

            const groupedResults = queryIncidenceFilter(rows, filter);

            console.log("filter:", filter);
            console.log("groupedResults:", groupedResults);

            if (groupedResults.length < 1) {
              renderBlankChart(cancerTypeToShow, myChart);
              renderBlankChart(cancerTypeToShow, myTable);
              setMessageText(
                "No data is available for these search filters.",
                "danger",
              );
            } else {
              // Data for charts
              const allChartSeries = returnAllChartSeries(groupedResults);

              // Data for tables (includes "all years")
              const allTableSeries = returnAllTableSeries(groupedResults);

              // ---------------------------------------------------------
              // Update chart and eCharts table
              // ---------------------------------------------------------

              clearMessageText(); // Remove search message text
              renderLineChart(
                cancerTypeToShow,
                allChartSeries,
                myChart,
                filter,
              );
              renderTableChart(
                cancerTypeToShow,
                allTableSeries,
                myTable,
                filter,
              );

              // ---------------------------------------------
              // Download
              // ---------------------------------------------

              const encodedUri = createTidyDownloadFile(groupedResults);
              const filename = createDownloadFilename(
                cancerTypeToShow + "_incidence",
              );
              downloadLinkBtn.innerHTML = `<a class="button is-link is-light mb-4"
                    href="${encodedUri}"
                    download="${filename}.csv">
                  Download CSV
                </a>`;
              // TODO: remove table code if confirm replacement with eCharts table

              // if (groupedResults.length === 1) {
              //   resultsContainer.innerHTML = generateSingleRowTable(
              //     cancerTypeToShow,
              //     groupedResults[0],
              //     filter,
              //   );
              // } else if (filter.sex.length > 1) {
              //   resultsContainer.innerHTML = generateDichotomyMultiRowTable(
              //     cancerTypeToShow,
              //     groupedResults,
              //     filter,
              //   );
              // } else {
              //   resultsContainer.innerHTML = generateMultiRowTable(
              //     cancerTypeToShow,
              //     groupedResults,
              //     filter,
              //   );
              // }
            }
          } catch (error) {
            console.error(error);
            const msg =
              error instanceof Error
                ? error.message
                : "Unable to process query.";
            setMessageText(msg, "danger");

            downloadLinkBtn.innerHTML = "<p></p>";
          }
        },

        error: (error: Error) => {
          setMessageText(`Parsing error: ${error.message}`, "danger");
        },
      });
    } catch (err) {
      setMessageText("Could not fetch CSV file with cancer data.", "danger");

      console.error(err);
    }
  });
</script>

<style>
  #csv-search-form {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  /* A responsive 1x2 grid container */
  .dashboard-container {
    display: grid;
    height: 100vh;
    width: 100vw;
    /* splits screen horizontally, with fixed left column */
    grid-template-columns: 21rem 1fr;
  }

  #search-panel {
    grid-column: 1;
    grid-row: 1;
    background-color: var(--color-surface);
    padding: 1rem 1.5rem;
    border-right: 1px solid var(--color-border-div);
  }

  #search-panel > * + * {
    margin-top: 1rem;
  }

  .search-section > * + * {
    margin-top: 0.25rem;
  }

  .h1-search {
    font-size: var(--font-size-h3);
    font-weight: 400;
  }
</style>
