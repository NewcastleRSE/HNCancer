---
import Layout from "../layouts/Layout.astro";
import Header from "./header.astro";
import CancerTypeSelect from "../components/CancerTypeSelect.astro";
import AgeSelect from "../components/AgeSelect.astro";
import DeprivationCheckboxSelect from "../components/DeprivationCheckboxSelect.astro";
import RegionCheckboxSelect from "../components/RegionCheckboxSelect.astro";
import PagePanels from "../components/PagePanels.astro";
import SexSelect from "../components/SexSelect.astro";
---

<Layout>
  <Header />

  <div class="dashboard-container">
    <!--- top left: panel area ---->
    <div id="panel">
      <h1 class="is-size-3 mb-4 mr-2">Dev Search</h1>
      <h2 class="is-size-5 mb-2">Select your search criteria</h2>
      <form id="inequalities-search-form">
        <CancerTypeSelect />
        <hr />
        <div class="mb-2">
          <input class="button" type="submit" value="Search" />
          <input class="button" type="reset" value="Reset" />
        </div>
      </form>
    </div>
    <PagePanels />
  </div>
</Layout>

<script>
  // Import PapaParse directly into your client bundle
  import Papa from "papaparse";
  import { cancerType } from "../utils/filter";
  import {
    generateSingleRowTable,
    generateMultiRowTable,
    generateDichotomyMultiRowTable,
  } from "../utils/filter-new";
  import {
    determineAgeInput,
    determineDepInput,
    determineRegionInput,
  } from "../utils/filter-new";
  import {
    age049checkbox,
    age5054checkbox,
    age5559checkbox,
    age6064checkbox,
    age6569checkbox,
    age7074checkbox,
    age7579checkbox,
    age8084checkbox,
    age8589checkbox,
    age90checkbox,
    imd1checkbox,
    imd2checkbox,
    imd3checkbox,
    imd4checkbox,
    imd5checkbox,
    emcheckbox,
    eecheckbox,
    locheckbox,
    necheckbox,
    nwcheckbox,
    secheckbox,
    swcheckbox,
    wmcheckbox,
    yhcheckbox,
    cancer_type,
    resultsContainer,
    downloadLinkBtn,
  } from "../types";
  import {
    returnAllChartSeries,
    renderLineChart,
    renderBlankChart,
    initLineChart,
  } from "../utils/charts";
  import { queryIncidenceFilter, initIncidenceFilter } from "../utils/query";
  import type { CSVRow, ProcessedRow } from "../types";

  // Initialise chart
  const myChart = initLineChart("csv-chart");

  const inequalities_form = document.getElementById(
    "inequalities-search-form",
  ) as HTMLFormElement;
  const radio_inputs = document.querySelectorAll(
    "input[type='radio']",
  ) as NodeListOf<HTMLInputElement>;

  inequalities_form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    // Initialise empty filter object for storing UI input
    // Will be passed to query function
    const filter = initIncidenceFilter();

    resultsContainer.innerHTML = "<p>Searching records...</p>";

    const CSV_file = cancerType(cancer_type.value);
    const cancerTypeToShow: string = cancer_type.value;

    console.log("CSV file: ", CSV_file);

    try {
      const response = await fetch(CSV_file);

      if (!response.ok) {
        throw new Error("Failed to retrieve data file.");
      }

      const csvText = await response.text();

      Papa.parse<CSVRow>(csvText, {
        header: true,
        skipEmptyLines: true,

        complete: (results) => {
          if (CSV_file === "") {
            renderBlankChart(cancerTypeToShow, myChart);

            resultsContainer.innerHTML =
              '<p class="has-text-danger">Please choose a cancer type.</p>';

            downloadLinkBtn.innerHTML = "<p></p>";

            return;
          }

          try {
            const rows = results.data as ProcessedRow[];

            // ---------------------------------------------
            // Temporary hard-coded filter for testing
            // ---------------------------------------------
            const filter1 = {
              dep: ["IMD1"],
              region: ["London"],
              sex: ["Male"],
              ageBand: ["50-54"],
              route: ["All Routes"],
              stage: ["All Stages"],
            };

            const filter2 = {
              dep: ["IMD1", "IMD2", "IMD3"],
              region: ["London"],
              sex: ["Male"],
              ageBand: ["50-54"],
              route: ["All Routes"],
              stage: ["All Stages"],
            };

            const filter3 = {
              dep: ["IMD1", "IMD4"],
              region: ["London"],
              sex: ["Male", "Female"],
              ageBand: ["50-54"],
              route: ["All Routes"],
              stage: ["All Stages"],
            };

            const filter4 = {
              dep: ["IMD1"],
              region: ["London", "South East", "South West"],
              sex: ["Male", "Female"],
              ageBand: ["50-54"],
              route: ["All Routes"],
              stage: ["All Stages"],
            };

            const filter5 = {
              // Too many multiselect variables
              dep: ["IMD1", "IMD4"],
              region: ["London", "South East", "South West"],
              sex: ["Male", "Female"],
              ageBand: ["50-54"],
              route: ["All Routes"],
              stage: ["All Stages"],
            };

            const filter = filter4;

            // ---------------------------------------------
            // Query
            // ---------------------------------------------

            const groupedResults = queryIncidenceFilter(rows, filter);

            console.log("filter:", filter);
            console.log("groupedResults:", groupedResults);

            // Data for charts and tables
            const allChartSeries = returnAllChartSeries(groupedResults);

            // ---------------------------------------------------------
            // Update Chart
            // ---------------------------------------------------------

            renderLineChart(cancerTypeToShow, allChartSeries, myChart);

            // ---------------------------------------------
            // Table/download
            // ---------------------------------------------

            if (groupedResults.length === 1) {
              resultsContainer.innerHTML = generateSingleRowTable(
                cancerTypeToShow,
                groupedResults[0],
                filter,
              );
            } else if (Array.isArray(filter.sex) && filter.sex.length > 1) {
              resultsContainer.innerHTML = generateDichotomyMultiRowTable(
                cancerTypeToShow,
                groupedResults,
                filter,
              );
            } else {
              resultsContainer.innerHTML = generateMultiRowTable(
                cancerTypeToShow,
                groupedResults,
                filter,
              );
            }
          } catch (error) {
            console.error(error);

            resultsContainer.innerHTML = `<p style="color: red;">${
              error instanceof Error
                ? error.message
                : "Unable to process query."
            }</p>`;

            downloadLinkBtn.innerHTML = "<p></p>";
          }
        },

        error: (error: Error) => {
          resultsContainer.innerHTML = `<p style="color: red;">Parsing error: ${error.message}</p>`;
        },
      });
    } catch (err) {
      resultsContainer.innerHTML =
        '<p style="color: red;">Could not fetch CSV file.</p>';

      console.error(err);
    }
  });
</script>

<style>
  #csv-search-form {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  /* A responsive 2x2 grid container */
  .dashboard-container {
    display: grid;
    height: 100vh;
    width: 100vw;
    /* splits screen horizontally, favoring left side a little */
    grid-template-columns: 25fr 75fr;
    /* splits screen vertically, favoring the top a little */
    grid-template-rows: 65fr 35fr;
  }

  #panel {
    padding-left: 20px;
    padding-top: 20px;
  }
</style>
