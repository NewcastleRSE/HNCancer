---
import Layout from "../layouts/Layout.astro";
import Header from "./header.astro";
---

<Layout>
  <Header />

  <main class="home-page">
    <div class="home-content">
      <img
        class="home-logo"
        src="/public/images/UNEQUAL-HNC_logo.svg"
        alt="Logo for Unequal-HNC: Unravelling Inequalities in Head and Neck Cancer. The Q in unequal is a magnifying glass containing the silhouette of a head."
        width="500"
      />

      <section class="introduction" aria-labelledby="home-title">
        <h1 id="home-title">
          [Placeholder for optional tagline to communicate core
          value/purpose/misison]
        </h1>
        <p>
          [Placeholder for home page text - recommend 1-3 sentences of big
          picture aims/goals/purpose of site (e.g., what you hope to achieve by
          sharing the data).]
        </p>
      </section>
    </div>
  </main>
</Layout>

<style>
  .home-page {
    padding: clamp(2rem, 6vw, 5rem) 1.25rem;
  }

  .home-content {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.5rem);
    width: 100%;
    max-width: 52rem;
    margin-inline: auto;
  }

  .home-logo {
    display: block;
    width: 100%;
    max-width: 42rem;
    height: auto;
    margin-inline: auto;
  }

  .introduction {
    width: 100%;
    max-width: 38rem;
    margin-inline: auto;
  }

  .introduction > * + * {
    margin-top: 1rem;
  }

  .introduction p {
    font-size: 1.25rem;
    line-height: 1.7;
  }
</style>
